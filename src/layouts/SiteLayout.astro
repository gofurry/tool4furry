---
import * as stylex from '@stylexjs/stylex';
import { region, regionConfig } from '../config/site';
import { messages } from '../i18n/messages';
import { siteStyles as s } from '../styles/site';
import '../styles/global.css';
interface Props { title: string; description?: string; workspace?: boolean; noindex?: boolean }
const { title, description, workspace = false, noindex = false } = Astro.props;
const t = messages[region];
const canonical = new URL(Astro.url.pathname, regionConfig.site);
---
<!doctype html>
<html lang={regionConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? t.intro} />
    <title>{title} · Tool4Furry</title>
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {import.meta.env.DEV && <>
      <link rel="stylesheet" href="/virtual:stylex.css" />
      <script is:inline type="module" src="/@id/virtual:stylex:css-only"></script>
    </>}
  </head>
  <body>
    <div {...stylex.attrs(s.frame)}>
      <a {...stylex.attrs(s.skip)} href="#main-content">{t.skip}</a>
      {!workspace && <header {...stylex.attrs(s.width)}>
        <nav {...stylex.attrs(s.nav)} aria-label={t.home}>
          <a {...stylex.attrs(s.brand)} href="/">Tool4Furry<span aria-hidden="true"> ↗</span></a>
          <a {...stylex.attrs(s.link)} href="https://github.com/gofurry/tool4furry">{t.source}</a>
        </nav>
      </header>}
      <slot />
      {!workspace && <footer {...stylex.attrs(s.width, s.footer)}>{t.footer}</footer>}
    </div>
  </body>
</html>
